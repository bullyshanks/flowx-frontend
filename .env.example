# API base URL — update when deploying
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# WhatsApp number (without +)
NEXT_PUBLIC_WHATSAPP=923158374442

# Brand
NEXT_PUBLIC_BRAND_NAME=FlowX

# ── Error tracking (Sentry) ──
# Leave unset to disable entirely — no account needed, nothing is sent.
# From sentry.io -> Project Settings -> Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Defaults to VERCEL_ENV / NODE_ENV. Set to separate preview from production.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Tracing sample rate 0-1. Default 0 (errors only) to protect free-tier quota.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Build-time only, for uploading source maps so stack traces are readable.
# Without these the build still succeeds, you just get minified traces.
# Create the token at sentry.io -> Settings -> Auth Tokens (scope: project:releases).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
